  special bond factors coul:  0        0        0       
     5 = max # of 1-2 neighbors
     8 = max # of 1-3 neighbors
    24 = max # of 1-4 neighbors
    26 = max # of special neighbors
  special bonds CPU = 0.000 seconds
  read_data CPU = 0.019 seconds

# ---- Force Field Settings (AFTER read_data)
pair_modify     mix geometric tail yes
kspace_style    pppm ${PPPM_ACC}
kspace_style    pppm 1e-05
special_bonds   lj/coul 0.0 0.0 0.5
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0.5     
  special bond factors coul:  0        0        0.5     
     5 = max # of 1-2 neighbors
     8 = max # of 1-3 neighbors
    24 = max # of 1-4 neighbors
    26 = max # of special neighbors
  special bonds CPU = 0.000 seconds

# ---- Neighbor List Settings
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# ---- Define Groups
# Framework: Zn_MO(1), N_MOF(2), O_MOF(3), C_MOF(4), H_MOF(5)
# CO2: cdc(6), cdo(7)
group           framework type 1 2 3 4 5
1188 atoms in group framework
group           co2       type 6 7
81 atoms in group co2
# CO2 carbons only (27 atoms) = molecular COMs for symmetric O=C=O
group           co2_com   type 6
27 atoms in group co2_com

# ---- Freeze Framework Atoms
velocity        framework set 0.0 0.0 0.0
fix             freeze framework setforce 0.0 0.0 0.0

# ---- Timestep
timestep        ${DT}
timestep        1

# ---- Initialize CO2 Velocities
velocity        co2 create ${T} ${SEED} mom yes rot yes dist gaussian
velocity        co2 create 298 ${SEED} mom yes rot yes dist gaussian
velocity        co2 create 298 12345 mom yes rot yes dist gaussian

# ---- Temperature Compute for CO2 Only
compute         Tco2 co2 temp

# ---- Thermodynamic Output Settings
thermo          ${THERMO_N}
thermo          500
thermo_style    custom step time temp c_Tco2 etotal pe ke evdwl ecoul elong ebond eangle edihed eimp press vol density
thermo_modify   temp Tco2
WARNING: Temperature for thermo pressure is not for group all (src/src/thermo.cpp:569)

# ---- Energy Check (zero-step run)
run             0
