LAMMPS (22 Jul 2025 - Update 2)
OMP_NUM_THREADS environment is not set. Defaulting to 1 thread.
  using 1 OpenMP thread(s) per MPI task
# LAMMPS INPUT SCRIPT
# -----------------------------
# CALF-20 (3x3x3) + 27 CO2
# Rigid framework, CO2 diffusion (MSD)
# Self-diffusion coefficient D extraction
# -----------------------------

# ---- Simulation Parameters
variable        DATA       string calf20_333_co2_27.data
variable        T          equal  298.0         # Temperature (K)
variable        DT         equal  1.0           # Timestep (fs)
variable        LJ_CUT     equal  12.0          # LJ cutoff (Angstrom)
variable        COUL_CUT   equal  12.0          # Coulomb cutoff (Angstrom)
variable        PPPM_ACC   equal  1.0e-5        # PPPM accuracy
variable        SEED       equal  12345         # Random seed

# Run lengths (steps)
variable        MIN_STEPS  equal  5000          # Max minimization steps
variable        EQ_STEPS   equal  50000         # 50 ps equilibration
variable        PR_STEPS   equal  1000000       # 1 ns production

# Output frequencies
variable        THERMO_N   equal  500           # Thermo output every 0.5 ps
variable        DUMP_N     equal  1000          # Trajectory dump every 1 ps
variable        MSD_N      equal  100           # MSD output every 0.1 ps

# ---- Initialization
units           real
atom_style      full
dimension       3
boundary        p p p

# ---- Force Field Styles (MUST be declared BEFORE read_data)
pair_style      lj/cut/coul/long ${LJ_CUT} ${COUL_CUT}
pair_style      lj/cut/coul/long 12 ${COUL_CUT}
pair_style      lj/cut/coul/long 12 12
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
improper_style  cvff

# ---- Read System Configuration
read_data       ${DATA}
read_data       calf20_333_co2_27.data
Reading data file ...
  triclinic box = (0 0 0) to (26.7414 29.0805 28.4508) with tilt (0 -12.425127 0)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
