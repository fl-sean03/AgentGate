undump          eq_traj
print           "=== Equilibration Complete ==="
=== Equilibration Complete ===

# ---- Production Phase
print           "=== Starting Production: 1 ns ==="
=== Starting Production: 1 ns ===
reset_timestep  0

# Production trajectory - unwrapped coordinates for diffusion analysis
dump            prod_traj all custom ${DUMP_N} prod.lammpstrj id mol type q x y z xu yu zu ix iy iz
dump            prod_traj all custom 1000 prod.lammpstrj id mol type q x y z xu yu zu ix iy iz
dump_modify     prod_traj sort id

# ---- MSD Computation for CO2 Molecular Centers-of-Mass
# For symmetric O=C=O: carbon position = molecular COM exactly
# Track 27 carbon atoms, com yes removes group drift
compute         msd_co2 co2_com msd com yes

# ---- MSD Output to File
# Columns: TimeStep MSD_x MSD_y MSD_z MSD_total
fix             msd_out all ave/time ${MSD_N} 1 ${MSD_N}                 c_msd_co2[1] c_msd_co2[2] c_msd_co2[3] c_msd_co2[4]                 file msd.dat mode scalar
fix             msd_out all ave/time 100 1 ${MSD_N}                 c_msd_co2[1] c_msd_co2[2] c_msd_co2[3] c_msd_co2[4]                 file msd.dat mode scalar
fix             msd_out all ave/time 100 1 100                 c_msd_co2[1] c_msd_co2[2] c_msd_co2[3] c_msd_co2[4]                 file msd.dat mode scalar

# ---- Production Run
run             ${PR_STEPS}
run             1000000
