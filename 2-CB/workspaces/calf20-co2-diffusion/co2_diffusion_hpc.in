# LAMMPS INPUT SCRIPT - HPC VERSION
# ============================================================
# CALF-20 (3x3x3) + 27 CO2 - Extended Production Run
#
# RESOURCE RECOMMENDATION:
#   - Cores per job: 8-16 (system too small for more)
#   - For 128 cores: Run 8 replicas × 16 cores each
#   - Wall time: 6 hours → ~10-15 ns per replica
#
# Run with: mpirun -np 16 lmp -in co2_diffusion_hpc.in -var SEED 12345
# ============================================================

# ---- Command-line variable for replica seeding ----
# Override with: -var SEED <value>
variable        SEED index 12345

# ---- Simulation Parameters ----
variable        DATA       string calf20_333_co2_27.data
variable        T          equal  298.0         # Temperature (K)
variable        DT         equal  1.0           # Timestep (fs)
variable        LJ_CUT     equal  12.0          # LJ cutoff (Angstrom)
variable        COUL_CUT   equal  12.0          # Coulomb cutoff (Angstrom)
variable        PPPM_ACC   equal  1.0e-5        # PPPM accuracy

# Run lengths (steps)
# With 16 cores: expect ~300-500 timesteps/s → 6-10M steps in 6 hours
variable        MIN_STEPS  equal  5000          # Max minimization steps
variable        EQ_STEPS   equal  100000        # 100 ps equilibration
variable        PR_STEPS   equal  10000000      # 10 ns production (adjust if needed)

# Output frequencies
variable        THERMO_N   equal  5000          # Thermo every 5 ps
variable        DUMP_N     equal  10000         # Trajectory every 10 ps
variable        MSD_N      equal  100           # MSD every 0.1 ps (100 fs)
variable        RESTART_N  equal  1000000       # Restart every 1 ns

# ---- Initialization ----
units           real
atom_style      full
dimension       3
boundary        p p p

# ---- Force Field Styles ----
pair_style      lj/cut/coul/long ${LJ_CUT} ${COUL_CUT}
bond_style      harmonic
angle_style     harmonic
dihedral_style  harmonic
improper_style  cvff

# ---- Read System Configuration ----
read_data       ${DATA}

# ---- Force Field Settings ----
pair_modify     mix geometric tail yes
kspace_style    pppm ${PPPM_ACC}
special_bonds   lj/coul 0.0 0.0 0.5

# ---- Neighbor List Settings ----
neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

# ---- Define Groups ----
group           framework type 1 2 3 4 5
group           co2       type 6 7
group           co2_com   type 6

# ---- Freeze Framework Atoms ----
velocity        framework set 0.0 0.0 0.0
fix             freeze framework setforce 0.0 0.0 0.0

# ---- Timestep ----
timestep        ${DT}

# ---- Initialize CO2 Velocities (seed from command line) ----
velocity        co2 create ${T} ${SEED} mom yes rot yes dist gaussian
print           "Using random seed: ${SEED}"

# ---- Temperature Compute for CO2 Only ----
compute         Tco2 co2 temp

# ---- Thermodynamic Output ----
thermo          ${THERMO_N}
thermo_style    custom step time temp c_Tco2 etotal pe ke press
thermo_modify   temp Tco2

# ---- Energy Check ----
run             0

# ---- Minimization ----
print           "=== Minimization ==="
min_style       cg
minimize        1.0e-4 1.0e-6 ${MIN_STEPS} 10000

# ---- Setup Dynamics ----
reset_timestep  0

fix             nvt_co2 co2 nvt temp ${T} ${T} 100.0
fix_modify      nvt_co2 temp Tco2
fix             mom_co2 co2 momentum 100 linear 1 1 1

# ============================================================
# EQUILIBRATION - 100 ps
# ============================================================
print           "=== Equilibration: 100 ps ==="
run             ${EQ_STEPS}
print           "=== Equilibration Complete ==="

# ============================================================
# PRODUCTION - 10 ns
# ============================================================
print           "=== Production: 10 ns (seed=${SEED}) ==="
reset_timestep  0

# MSD compute
compute         msd_co2 co2_com msd com yes

# MSD output (100 fs resolution)
fix             msd_out all ave/time ${MSD_N} 1 ${MSD_N} &
                c_msd_co2[1] c_msd_co2[2] c_msd_co2[3] c_msd_co2[4] &
                file msd_${SEED}.dat mode scalar

# Trajectory (sparse)
dump            traj all custom ${DUMP_N} traj_${SEED}.lammpstrj &
                id mol type q xu yu zu
dump_modify     traj sort id

# Checkpoints
restart         ${RESTART_N} restart_${SEED}.a restart_${SEED}.b

# Run
run             ${PR_STEPS}

# ============================================================
# FINAL OUTPUT
# ============================================================
write_restart   restart_${SEED}.final
write_data      final_${SEED}.data nocoeff

print           "========================================"
print           "Simulation Complete (seed=${SEED})"
print           "MSD: msd_${SEED}.dat"
print           "========================================"
