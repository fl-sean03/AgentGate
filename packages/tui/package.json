{
  "name": "@agentgate/tui",
  "version": "0.2.28",
  "description": "AgentGate terminal user interface - beautiful TUI for AI-powered code changes",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentgate": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentgate/shared": "workspace:*",
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "eventsource": "^2.0.2",
    "ink": "^5.0.1",
    "ink-spinner": "^5.0.0",
    "ky": "^1.7.2",
    "open": "^10.1.0",
    "react": "^18.3.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@types/eventsource": "^1.1.15",
    "@types/node": "^20.10.6",
    "@types/react": "^18.3.12",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.2.2",
    "tsup": "^8.3.5",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
